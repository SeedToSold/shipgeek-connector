# Local development uses SQLite. Production uses Postgres, for example:
# DATABASE_URL="postgresql://user:password@host:5432/shipgeek_connector"
DATABASE_URL="file:./dev.sqlite"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://localhost"
SCOPES="read_assigned_fulfillment_orders,write_draft_orders,read_draft_orders,read_fulfillments,read_inventory,read_locations,read_merchant_managed_fulfillment_orders,write_order_edits,read_orders,write_orders,read_products,read_shipping,read_third_party_fulfillment_orders"
